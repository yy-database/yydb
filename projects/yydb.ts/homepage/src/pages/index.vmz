await db.execute('User { id: 1, name: "Ada", active: true }.insert()');
await db.execute('User { id: 2, name: "Lin", active: false }.insert()');
const active = await db.query("User.all().filter(x => x.active).collect()");
console.log(JSON.stringify(active));
await db.checkpoint();
await db.close();`;
