                        <div class="filemap__row filemap__row--pages">
                            <span class="filemap__offset">0x0140</span>
                            <span class="filemap__name">YDPG PAGES</span>
                            <span class="filemap__spec">4096 B · CRC32C</span>
                            <span class="filemap__pages" aria-hidden="true">
                                <b>01</b><b>02</b><b>03</b><b>04</b><b>05</b><b>06</b><b>07</b><b>08</b>
                            </span>
                        </div>
                        <div class="filemap__row filemap__row--free">
                            <span class="filemap__offset">0x----</span>
                            <span class="filemap__name">FREE</span>
                            <span class="filemap__spec">REUSABLE PAGES</span>
                        </div>
                        <div class="filemap__wal">
                            <span class="filemap__wal-label"><i class="filemap__dot" aria-hidden="true"></i>YYWL · WRITE-AHEAD LOG</span>
                            <span class="filemap__wal-note">APPEND-ONLY → CHECKPOINT TO PAGES</span>
                        </div>
                    </div>
                    <figcaption><span>{{ homeDiagramCaptionLabel }}</span><span aria-hidden="true">YDPG · YYWL · VOS · CRC32C</span></figcaption>
