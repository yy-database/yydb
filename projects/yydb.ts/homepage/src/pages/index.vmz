                        <g class="flow-node"><path d="M740 40H830M740 52H830M740 64H830M740 76H830M740 88H830" fill="none"/><text x="785" y="118" text-anchor="middle">YDPG PAGES</text></g>
                        <g class="flow-file"><path d="M960 40h110l26 26v54h-136zM1070 40v26h26"/><text x="1022" y="72" text-anchor="middle">.yydb</text></g>
                        <path class="flow-pulse" d="M88 64H1096" fill="none"/>
                    </svg>
                </figure>
                <div class="engine__grid">
                    <article class="engine__note">
                        <h3>{{ homeAnatomyWalTitleLabel }}</h3>
                        <p>{{ homeAnatomyWalBodyLabel }}</p>
                    </article>
                    <div class="code-panel">
                        <div class="code-panel__top"><span>app.ts</span><span>VOS × NODE.JS</span></div>
                        <pre class="code-panel__raw">{{ codeSample }}</pre>
                        <div class="code-panel__bottom"><span>LOCAL FILE</span><span>app.yydb</span></div>
                    </div>
                </div>
            </div>
