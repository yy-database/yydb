                <figure class="engine__flow">
                    <svg viewBox="0 0 1200 150" role="img" aria-label="Write path from WAL to pages">
                        <g class="flow-ruler"><path d="M24 132H1096"/><path d="M24 132v5M91 132v5M158 132v5M225 132v5M292 132v5M359 132v5M426 132v5M493 132v5M560 132v5M627 132v5M694 132v5M761 132v5M828 132v5M895 132v5M962 132v5M1029 132v5M1096 132v5"/></g>
                        <g class="flow-bus" fill="none"><path d="M88 64H270M360 64H520M560 64H740M830 64H960"/></g>
