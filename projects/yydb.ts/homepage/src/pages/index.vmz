                        <a class="btn-signal" href="/install">{{ homeActionInstallLabel }}</a>
                        <a class="doc-link" href="/d/">{{ homeActionDocsLabel }}<span aria-hidden="true">→</span></a>
                    </div>
                </div>
                <figure class="hero__visual">
                    <div class="filemap" role="img" :aria-label="homeDiagramCaptionLabel">
                        <div class="filemap__head">
                            <span class="filemap__file">app.yydb</span>
                            <span class="filemap__meta">ONE FILE · 4096 B PAGES</span>
                        </div>
                        <div class="filemap__row">
                            <span class="filemap__offset">0x0000</span>
                            <span class="filemap__name">HEADER</span>
                            <span class="filemap__spec">MAGIC · VERSION</span>
                        </div>
                        <div class="filemap__row">
                            <span class="filemap__offset">0x0040</span>
                            <span class="filemap__name">VOS SCHEMA DOC</span>
                            <span class="filemap__spec">USERS · ORDERS · INDEXES</span>
