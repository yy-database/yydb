<script client>
import { homeEyebrow, homeHeroLine1, homeHeroLine2, homeLede, homeActionInstall, homeActionDocs, homeInstallHint, homePrinciple1Title, homePrinciple1Body, homePrinciple2Title, homePrinciple2Body, homePrinciple3Title, homePrinciple3Body, homeFeatureTitle, homeFeatureLede, homeFeatureSchemaTitle, homeFeatureSchemaBody, homeFeatureDurabilityTitle, homeFeatureDurabilityBody, homeFeatureHostTitle, homeFeatureHostBody, homeArchitectureTitle, homeArchitectureBody, homeArchitectureLink, homeClosingTitle, homeClosingBody, homeClosingAction, homeDiagramCaption, homeEdition, titleHome } from "#locales/common";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../lib/locale-copy.ts";

export default class Home {
    codeSample = `import { Database } from "@yydb/yydb";

const db = await Database.open("app.yydb");

const users = await db.query(
  "User.all().collect()"
);

await db.close();`;
    homeEyebrowLabel = "";
    homeHeroLine1Label = "";
    homeHeroLine2Label = "";
    homeLedeLabel = "";
    homeActionInstallLabel = "";
    homeActionDocsLabel = "";
    homeInstallHintLabel = "";
    homePrinciple1TitleLabel = "";
    homePrinciple1BodyLabel = "";
    homePrinciple2TitleLabel = "";
    homePrinciple2BodyLabel = "";
    homePrinciple3TitleLabel = "";
    homePrinciple3BodyLabel = "";
    homeFeatureTitleLabel = "";
    homeFeatureLedeLabel = "";
    homeFeatureSchemaTitleLabel = "";
    homeFeatureSchemaBodyLabel = "";
    homeFeatureDurabilityTitleLabel = "";
    homeFeatureDurabilityBodyLabel = "";
    homeFeatureHostTitleLabel = "";
    homeFeatureHostBodyLabel = "";
    homeArchitectureTitleLabel = "";
    homeArchitectureBodyLabel = "";
    homeArchitectureLinkLabel = "";
    homeClosingTitleLabel = "";
    homeClosingBodyLabel = "";
    homeClosingActionLabel = "";
    homeDiagramCaptionLabel = "";
    homeEditionLabel = "";
    _unwatchLocale = null;
    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }
    onDestroy() {
        if (typeof this._unwatchLocale === "function") this._unwatchLocale();
        this._unwatchLocale = null;
    }
    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }
    refreshCopy() {
        this.homeEyebrowLabel = homeEyebrow();
        this.homeHeroLine1Label = homeHeroLine1();
        this.homeHeroLine2Label = homeHeroLine2();
        this.homeLedeLabel = homeLede();
        this.homeActionInstallLabel = homeActionInstall();
        this.homeActionDocsLabel = homeActionDocs();
        this.homeInstallHintLabel = homeInstallHint();
        this.homePrinciple1TitleLabel = homePrinciple1Title();
        this.homePrinciple1BodyLabel = homePrinciple1Body();
        this.homePrinciple2TitleLabel = homePrinciple2Title();
        this.homePrinciple2BodyLabel = homePrinciple2Body();
        this.homePrinciple3TitleLabel = homePrinciple3Title();
        this.homePrinciple3BodyLabel = homePrinciple3Body();
        this.homeFeatureTitleLabel = homeFeatureTitle();
        this.homeFeatureLedeLabel = homeFeatureLede();
        this.homeFeatureSchemaTitleLabel = homeFeatureSchemaTitle();
        this.homeFeatureSchemaBodyLabel = homeFeatureSchemaBody();
        this.homeFeatureDurabilityTitleLabel = homeFeatureDurabilityTitle();
        this.homeFeatureDurabilityBodyLabel = homeFeatureDurabilityBody();
        this.homeFeatureHostTitleLabel = homeFeatureHostTitle();
        this.homeFeatureHostBodyLabel = homeFeatureHostBody();
        this.homeArchitectureTitleLabel = homeArchitectureTitle();
        this.homeArchitectureBodyLabel = homeArchitectureBody();
        this.homeArchitectureLinkLabel = homeArchitectureLink();
        this.homeClosingTitleLabel = homeClosingTitle();
        this.homeClosingBodyLabel = homeClosingBody();
        this.homeClosingActionLabel = homeClosingAction();
        this.homeDiagramCaptionLabel = homeDiagramCaption();
        this.homeEditionLabel = homeEdition();
        if (typeof document !== "undefined") document.title = titleHome();
    }
}
</script>
