<template>
    <SiteHeader />
    <main class="welcome" id="main" aria-labelledby="welcome-title">
        <div class="welcome__inner">
            <p class="welcome__kicker">{{ welcomeKickerLabel }}</p>
            <h1 class="welcome__title" id="welcome-title">
                {{ welcomeTitleLeadLabel }}
                <em>{{ welcomeTitleEmLabel }}</em>
            </h1>
            <p class="welcome__lede">{{ welcomeLedeLabel }}</p>
            <div class="welcome__actions">
                <a class="btn btn--primary" href="/">{{ welcomeEnterLabel }}</a>
                <a class="btn" href="/d/">{{ welcomeDocsLabel }}</a>
                <a class="btn btn--quiet" href="/wire">{{ welcomeWireLabel }}</a>
            </div>
            <p class="welcome__note">{{ welcomeNoteLabel }}</p>
        </div>
    </main>
    <SiteFooter />
</template>

<script client>
import {
    welcomeKicker,
    welcomeTitleLead,
    welcomeTitleEm,
    welcomeLede,
    welcomeEnter,
    welcomeDocs,
    welcomeWire,
    welcomeNote,
} from "#locales/common";
import { readLocaleId, withLocaleHint, watchDocumentLocale } from "../lib/locale-copy.ts";

export default class WelcomePage {
    welcomeKickerLabel = "";
    welcomeTitleLeadLabel = "";
    welcomeTitleEmLabel = "";
    welcomeLedeLabel = "";
    welcomeEnterLabel = "";
    welcomeDocsLabel = "";
    welcomeWireLabel = "";
    welcomeNoteLabel = "";
    _unwatchLocale = null;

    onMount() {
        this.applyLocaleCopy();
        this._unwatchLocale = watchDocumentLocale((id) => this.applyLocaleCopy(id));
    }

    onDestroy() {
        if (typeof this._unwatchLocale === "function") {
            this._unwatchLocale();
        }
        this._unwatchLocale = null;
    }

    refreshCopy() {
        this.welcomeKickerLabel = welcomeKicker();
        this.welcomeTitleLeadLabel = welcomeTitleLead();
        this.welcomeTitleEmLabel = welcomeTitleEm();
        this.welcomeLedeLabel = welcomeLede();
        this.welcomeEnterLabel = welcomeEnter();
        this.welcomeDocsLabel = welcomeDocs();
        this.welcomeWireLabel = welcomeWire();
        this.welcomeNoteLabel = welcomeNote();
    }

    applyLocaleCopy(preferred) {
        withLocaleHint(readLocaleId(preferred), () => this.refreshCopy());
    }
}
</script>
