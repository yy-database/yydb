{
    "name": "@yydb/yydb-webui",
    "version": "0.1.5",
    "description": "Local browser UI for inspecting a running YYDB server",
    "license": "MPL-2.0",
    "private": true,
    "type": "module",
    "scripts": {
        "check": "vmz check .",
        "dev": "vmz dev .",
        "build": "vmz build . --release --profile static",
        "preview": "vmz serve . --profile static"
    },
    "files": [
        "dist",
        "README.md"
    ],
    "exports": {
        "./package.json": "./package.json",
        "./dist/cdn/*": "./dist/cdn/*"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yy-database/yydb.git",
        "directory": "projects/yydb.ts/packages/yydb-webui"
    },
    "homepage": "https://github.com/yy-database/yydb/tree/dev/projects/yydb.ts/packages/yydb-webui#readme",
    "bugs": {
        "url": "https://github.com/yy-database/yydb/issues"
    },
    "dependencies": {
        "@vmz/core": "0.3.12",
        "@vmz/plugin": "0.3.12",
        "@vmz/ui": "0.3.12",
        "@vmz/ui-icons": "0.3.12",
        "@yydb/yydb-client": "workspace:*"
    },
    "devDependencies": {
        "@vmz/vmz": "0.3.12",
        "typescript": "^5.9.2"
    }
}
