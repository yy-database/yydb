{
    "name": "@yydb/light-db",
    "version": "0.1.14",
    "description": "Light DB — browser-native YYDB database backed by Rust WASM (yydb-unknown-wasm32)",
    "main": "dist/index.js",
    "types": "dist/index.d.ts",
    "files": [
        "dist"
    ],
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
        "test": "vitest run",
        "test:watch": "vitest",
        "test:browser": "vite build -c tests/browser/vite.config.ts && node --experimental-strip-types tests/browser/run-browser-tests.ts"
    },
    "keywords": [
        "yydb",
        "light-db",
        "database",
        "browser",
        "opfs",
        "wal",
        "typescript"
    ],
    "license": "MPL-2.0",
    "author": "YYDB Contributors",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yy-database/yydb.git",
        "directory": "projects/yydb.ts/packages/light-db"
    },
    "homepage": "https://github.com/yy-database/yydb/tree/dev/projects/yydb.ts/packages/light-db#readme",
    "bugs": {
        "url": "https://github.com/yy-database/yydb/issues"
    },
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^20.19.43",
        "playwright-core": "^1.64.1",
        "tsx": "^4.23.15",
        "typescript": "^5.3.0",
        "vite": "^6.3.5",
        "vitest": "^1.6.0"
    },
    "dependencies": {
        "@voml/vos": "^0.0.5",
        "@yydb/yydb-unknown-wasm32": "workspace:*"
    }
}
