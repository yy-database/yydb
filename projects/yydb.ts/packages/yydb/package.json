{
    "name": "@yydb/yydb",
    "version": "0.1.10",
    "description": "YYDB Node embedded engine and CLI",
    "license": "MPL-2.0",
    "type": "module",
    "bin": {
        "yydb": "dist/cli.js"
    },
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./cli": {
            "types": "./dist/cli.d.ts",
            "import": "./dist/cli.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json && node scripts/bundle-webui.mjs",
        "typecheck:tests": "tsc --noEmit -p tsconfig.tests.json",
        "test": "node --experimental-strip-types --test \"src/**/*.test.ts\" \"tests/**/*.test.ts\""
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yy-database/yydb.git",
        "directory": "projects/yydb.ts/packages/yydb"
    },
    "homepage": "https://github.com/yy-database/yydb/tree/dev/projects/yydb.ts/packages/yydb#readme",
    "bugs": {
        "url": "https://github.com/yy-database/yydb/issues"
    },
    "keywords": [
        "yydb",
        "vos",
        "database",
        "embedded",
        "typescript"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@vmz/commander": "^0.3.5",
        "@vmz/diagnostic": "^0.3.5",
        "@voml/vos": "^0.0.5"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "@yydb/sqlite-fixtures": "workspace:*",
        "@yydb/yydb-fixtures": "workspace:*",
        "@yydb/yydb-webui": "workspace:*",
        "typescript": "~5.3.0"
    },
    "engines": {
        "node": ">=18"
    },
    "optionalDependencies": {
        "@yydb/yydb-darwin-arm64": "workspace:*",
        "@yydb/yydb-darwin-x64": "workspace:*",
        "@yydb/yydb-linux-x64": "workspace:*",
        "@yydb/yydb-win32-x64": "workspace:*"
    }
}
