{
    "name": "@yydb/yydb-client",
    "version": "0.1.3",
    "description": "TypeScript client for the YYDB WebSocket and TCP wire protocol",
    "license": "MPL-2.0",
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/index.d.ts",
            "import": "./dist/index.js"
        },
        "./node": {
            "types": "./dist/node.d.ts",
            "import": "./dist/node.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "pnpm run build && node --experimental-strip-types --test src/**/*.test.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yy-database/yydb.git",
        "directory": "projects/packages/yydb-client"
    },
    "homepage": "https://github.com/yy-database/yydb/tree/dev/projects/packages/yydb-client#readme",
    "bugs": {
        "url": "https://github.com/yy-database/yydb/issues"
    },
    "keywords": [
        "yydb",
        "yyds",
        "vos",
        "wire-protocol",
        "typescript"
    ],
    "publishConfig": {
        "access": "public"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "typescript": "~5.3.0"
    },
    "engines": {
        "node": ">=18"
    }
}
