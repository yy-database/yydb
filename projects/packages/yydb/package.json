{
    "name": "@yydb/yydb",
    "version": "0.1.0",
    "description": "YYDB all-in-one for Node: embedded engine, CLI, and local serve",
    "license": "MPL-2.0",
    "private": true,
    "type": "module",
    "bin": {
        "yydb": "./dist/node/cli.js"
    },
    "main": "./dist/node/index.js",
    "types": "./dist/node/index.d.ts",
    "exports": {
        ".": {
            "types": "./dist/node/index.d.ts",
            "import": "./dist/node/index.js"
        },
        "./cli": {
            "types": "./dist/node/cli.d.ts",
            "import": "./dist/node/cli.js"
        }
    },
    "files": [
        "dist",
        "README.md"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.json",
        "test": "pnpm run build && node --experimental-strip-types --test src/node/**/*.test.ts src/shared/**/*.test.ts"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yy-database/yydb.rs.git",
        "directory": "projects/packages/yydb"
    },
    "homepage": "https://github.com/yy-database/yydb.rs/tree/dev/projects/packages/yydb#readme",
    "bugs": {
        "url": "https://github.com/yy-database/yydb.rs/issues"
    },
    "keywords": [
        "yydb",
        "vos",
        "database",
        "embedded",
        "typescript"
    ],
    "publishConfig": {
        "access": "public"
    },
    "dependencies": {
        "@vmz/commander": "^0.2.0",
        "@yydb/yydb-client": "workspace:*"
    },
    "devDependencies": {
        "@types/node": "^20.10.0",
        "typescript": "~5.3.0"
    },
    "engines": {
        "node": ">=18"
    },
    "optionalDependencies": {
        "@yydb/yydb-win32-x64": "workspace:*",
        "@yydb/yydb-linux-x64": "workspace:*",
        "@yydb/yydb-darwin-x64": "workspace:*",
        "@yydb/yydb-darwin-arm64": "workspace:*"
    }
}
