{
    "compilerOptions": {
        "target": "ES2022",
        "module": "ES2022",
        "moduleResolution": "bundler",
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "skipLibCheck": true,
        "lib": ["ES2022"],
        "types": ["node"]
    },
    "include": ["src/node/**/*.ts", "src/shared/**/*.ts"],
    "exclude": ["src/**/*.test.ts"]
}
