"""Type stubs for the ``yydb_pyo3`` native extension module.

The extension is built from ``projects/yydb.rs/ffis/yydb-pyo3`` and imported
by name, so these signatures mirror that module rather than a package
submodule. They exist for editors and type checkers only.
"""

from typing import Any

def version() -> str: ...
def serve(db_path: str, bind: str, insecure_bind: bool | None = ...) -> None: ...
def init_db(db_path: str, schema_document: str | None = ...) -> None: ...
def info_text(db_path: str) -> str: ...
def read_schema_file(schema_path: str) -> str: ...
def query_vos(db_path: str, source: str) -> list[dict[str, Any]]: ...
def execute_vos_write(db_path: str, source: str, params: dict[str, Any]) -> None: ...
def execute_vos_transaction(db_path: str, statements: list[tuple[str, dict[str, Any]]]) -> None: ...
def put_file(db_path: str, payload: bytes, chunk_size: int, name: str | None = ..., media_type: str | None = ...) -> dict[str, Any]: ...
def read_file_window(db_path: str, descriptor: dict[str, Any], offset: int, length: int) -> bytes: ...
def read_file(db_path: str, descriptor: dict[str, Any]) -> bytes: ...

