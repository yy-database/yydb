{
    "$schema": "https://biomejs.dev/schemas/2.5.7/schema.json",
    "formatter": {
        "enabled": true,
        "indentStyle": "space",
        "indentWidth": 4,
        "lineWidth": 100,
        "lineEnding": "lf"
    },
    "javascript": {
        "formatter": {
            "quoteStyle": "double",
            "semicolons": "always",
            "trailingCommas": "all",
            "arrowParentheses": "always"
        }
    },
    "json": {
        "formatter": {
            "trailingCommas": "none"
        }
    },
    "linter": {
        "enabled": false
    },
    "files": {
        "includes": [
            "package.json",
            "biome.json",
            "scripts/**",
            "projects/packages/**",
            "!**/node_modules/**",
            "!**/dist/**",
            "!**/target/**",
            "!**/.vite/**",
            "!**/pnpm-lock.yaml",
            "!**/fixtures/**",
            "!**/*.generated.ts",
            "!**/*.md",
            "!**/*.css",
            "!**/*.vue"
        ]
    }
}
